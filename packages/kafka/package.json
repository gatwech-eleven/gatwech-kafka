{
  "name": "@gatwech/kafka",
  "version": "0.1.0-beta.0",
  "description": "Payvo Node.js Kafka Client for Microservices Messaging",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown --tsconfig tsconfig.build.json",
    "dev": "tsdown --watch",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "kafka",
    "microservices",
    "messaging",
    "event-driven",
    "payvo"
  ],
  "author": "Gatwech Tap Nguth",
  "license": "ISC",
  "dependencies": {
    "@gatwech/core": "1.0.0-beta.26",
    "@gatwech/utils": "^0.5.3",
    "kafkajs": "^2.2.4",
    "nanoid": "^5.1.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsdown": "catalog:default",
    "typescript": "catalog:default",
    "vitest": "catalog:default"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.cjs"
    },
    "./topics": {
      "types": "./dist/topics/index.d.mts",
      "import": "./dist/topics/index.mjs",
      "require": "./dist/topics/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "client": [
        "dist/client/index.d.mts"
      ],
      "topics": [
        "dist/topics/index.d.mts"
      ],
      "*": [
        "dist/index.d.mts"
      ]
    }
  },
  "packageManager": "pnpm@10.20.0"
}
