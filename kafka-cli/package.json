{
  "name": "@gatwech/kafka-cli",
  "version": "0.1.0",
  "description": "CLI tool for @gatwech/kafka",
  "type": "module",
  "bin": {
    "kafka-cli": "./dist/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "import": "./dist/types/index.mjs"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/index.ts",
    "kafka": "node ./dist/index.mjs",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gatwech/kafka": "workspace:*",
    "commander": "^12.1.0",
    "inquirer": "^10.2.2",
    "chalk": "^5.3.0",
    "ora": "^8.1.0",
    "cli-table3": "^0.6.5",
    "dotenv": "^16.4.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^24.10.1",
    "tsdown": "^0.16.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  }
}