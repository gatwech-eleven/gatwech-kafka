{
  "name": "@gatwech/kafka",
  "version": "0.0.7",
  "description": "Payvo Node.js Kafka Client for Microservices Messaging",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx ./e2e/run-e2e.ts",
    "generate:kafka-config": "tsx ./scripts/generate-kafka-config.ts",
    "init:kafka-topics": "bash scripts/kafka-init.sh",
    "setup:kafka": "pnpm run generate:kafka-config && pnpm run init:kafka-topics"
  },
  "keywords": [
    "kafka",
    "microservices",
    "messaging",
    "event-driven",
    "payvo"
  ],
  "author": "Gatwech Tap Nguth",
  "license": "ISC",
  "dependencies": {
    "@gatwech/utils": "^0.5.3",
    "buffer": "^6.0.3",
    "kafkajs": "^2.2.4",
    "nanoid": "^5.1.6",
    "prom-client": "^15.1.2",
    "winston": "^3.17.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "biome": "^0.3.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsdown": "^0.16.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.9"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./topics": {
      "types": "./dist/config/topics/index.d.ts",
      "import": "./dist/config/topics/index.mjs",
      "require": "./dist/config/topics/index.cjs"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.mjs",
      "require": "./dist/client/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.cjs"
    },
    "./ensure-topics": {
      "types": "./dist/config/ensure-topics.d.ts",
      "import": "./dist/config/ensure-topics.mjs",
      "require": "./dist/config/ensure-topics.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "client": [
        "dist/client/index.d.ts"
      ],
      "topics": [
        "dist/config/topics/index.d.ts"
      ],
      "types": [
        "dist/types/index.d.ts"
      ],
      "ensure-topics": [
        "dist/config/ensure-topics.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "packageManager": "pnpm@10.20.0"
}
