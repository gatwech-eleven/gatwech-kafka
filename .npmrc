; If you need to authenticate to the npm registry in CI, set NODE_AUTH_TOKEN or
; write an auth token to ~/.npmrc in your workflow. The literal placeholder
; below caused warnings when NODE_AUTH_TOKEN is not present locally, so it's
; commented out to avoid noise during local tests.
; //registry.npmjs.org/:_authToken=${NODE_AUTH_TOKEN}
registry=https://registry.npmjs.org/
always-auth=true