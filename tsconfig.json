{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "module": "preserve",
    "noEmit": true,
    "declaration": true,
    "types": ["node", "vitest"],
    "lib": ["es2022", "dom", "dom.iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "./src/**/*",
    "src/types.ts",
    "index.d.ts",
    "./e2e/**/*",
    "tsdown.config.ts",
    "vitest.config.ts",
    "./__tests__/**/*"
  ],
  "ts-node": {
    "files": true
  },
  "exclude": ["node_modules", "dist"]
}
