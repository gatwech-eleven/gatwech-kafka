{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "outDir": "./dist",
    "strict": true,
    "noEmit": true,
    "module": "preserve",
    "types": ["node", "vitest"],
    "lib": ["es2022", "dom", "dom.iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src",
    "e2e",
    "__tests__",
    "tsdown.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
