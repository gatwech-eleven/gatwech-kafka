{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "outDir": "build",
    "sourceMap": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["./src/**/*", "src/types.ts", "index.d.ts"],
  "ts-node": {
    "files": true
  },
  "exclude": ["node_modules"]
}
